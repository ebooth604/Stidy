# Hyperliquid API base URLs (mainnet by default; swap to testnet for safe experimentation)
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Anthropic API key — required for /api/ai/* routes (digest, tuning, chat).
# Without it the AI routes return a clear 503 rather than failing silently.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite file path (created automatically on first run)
DATABASE_PATH=./data/stidy.db

# HTTP server
PORT=8787

# CORS: comma-separated list of allowed origins for the web dashboard
CORS_ORIGINS=http://localhost:5173

# Signal engine
SIGNAL_POLL_INTERVAL_MS=15000
BASIS_GAP_ALERT_PCT=0.15
FUNDING_APR_ALERT_PCT=30
WHALE_TRADE_USD=250000

# Bot engine
BOT_TICK_MS=15000

# AI digest cache lifetime
AI_DIGEST_INTERVAL_MINUTES=20

# CoinMarketCap API key — OPTIONAL. Get your own at https://coinmarketcap.com/api/
# (never commit a real key here). When set, an extra "cmc_basis" signal compares
# Hyperliquid's mark price against CMC's aggregated spot price as an independent
# cross-check on top of Hyperliquid's own oracle price, and a matching
# "cmc_basis_reversion" bot strategy becomes usable. Left blank, this feature is
# simply inactive — everything else works fine without it.
CMC_API_KEY=
CMC_API_URL=https://pro-api.coinmarketcap.com
# Floor is enforced at 30s in code regardless of this value (CMC free-tier plan limit).
CMC_POLL_INTERVAL_MS=30000
CMC_WATCHLIST_SIZE=15
CMC_BASIS_GAP_ALERT_PCT=0.25
